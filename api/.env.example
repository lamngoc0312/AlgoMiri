# Server-side LLM configuration (NEVER commit real keys or expose them in web/)
# Real OS environment variables always take precedence over values in api/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Allowed frontend origins (comma-separated, wildcards like * are rejected)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upstream reliability & bounded retry limits
LLM_TIMEOUT_SECONDS=25
LLM_MAX_RETRIES=1

# Request size & abuse safeguards (note: CORS & prompts alone do NOT protect public AI endpoints)
MAX_STATEMENT_CHARS=6000
MAX_REQUEST_BODY_BYTES=32768
MAX_TUTOR_REQUEST_BYTES=16384
RATE_LIMIT_PER_MINUTE=20
DAILY_REQUEST_BUDGET=500
MAX_CONCURRENT_LLM_REQUESTS=5
